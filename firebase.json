{
  "functions": [
    {
      "source": ".",
      "codebase": "screen-timers",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        ".openai",
        "*.test.js",
        "rules.test.js",
        "index.html",
        "app.js",
        "styles.css",
        "firebase-sdk.js",
        "firebase-entry.js",
        "messaging-entry.js",
        "push-sdk.js",
        "sw.js",
        "manifest.webmanifest",
        "icon-*.png",
        "README.md",
        "SETUP.md",
        "TEST_REPORT.md",
        "CHANGELOG.md",
        "build.js",
        "bootstrap.js",
        "firebase-debug.log",
        "firestore-debug.log",
        "ui-check*",
        "*.zip",
        "app-bundle.js",
        "storage.js",
        "SPECIFICATION.md"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    }
  },
  "singleProjectMode": true
}
